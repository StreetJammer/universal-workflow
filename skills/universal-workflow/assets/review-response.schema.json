{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["proposals"],
  "additionalProperties": false,
  "properties": {
    "proposals": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["key", "kind", "body", "reason", "ttl_days", "evidence_event_ids"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"},
          "kind": {"enum": ["fact", "lesson", "preference", "workflow"]},
          "body": {"type": "string", "minLength": 1, "maxLength": 8000},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "ttl_days": {"type": "integer", "minimum": 1, "maximum": 3650},
          "evidence_event_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
